# Server
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Production database (Neon PostgreSQL). Leave empty to use local SQLite.
DATABASE_URL=

# Material providers — keep real values in .env only
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
GIPHY_API_KEY=
FREESOUND_API_KEY=

# Optional AI query enhancement
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Stripe subscription billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PRICE_LABEL=价格以付款页面为准
STRIPE_WEBHOOK_SECRET=
