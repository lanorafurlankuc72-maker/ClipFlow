{
  "name": "@clipflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clipflow/providers": "workspace:*",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.2.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "eslint": "9.33.0",
    "supertest": "7.1.4",
    "@types/supertest": "6.0.3",
    "tsx": "4.20.5",
    "typescript-eslint": "8.40.0",
    "vitest": "3.2.4"
  }
}
